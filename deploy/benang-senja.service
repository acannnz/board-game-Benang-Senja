[Unit]
Description=Benang Senja - server room online
After=network.target

[Service]
Type=simple
User=arcandapp
Group=arcandapp
WorkingDirectory=/home/arcandapp/benang-senja-server
Environment=PORT=3088
Environment=HOST=127.0.0.1
Environment=DATA_FILE=/home/arcandapp/benang-senja-server/rooms.json
# halaman disajikan nginx dari public_html, server ini hanya melayani /ws
Environment=SERVE_STATIC=0
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
